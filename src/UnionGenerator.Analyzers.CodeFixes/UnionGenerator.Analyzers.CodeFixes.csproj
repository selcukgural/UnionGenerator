<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>UnionGenerator.Analyzers.CodeFixes</AssemblyName>
    <PackageType>Analyzer</PackageType>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>

    <!-- NuGet Package Metadata -->
    <Version>0.1.0</Version>
    <PackageId>UnionGenerator.Analyzers.CodeFixes</PackageId>
    <Authors>Selçuk Güral</Authors>
    <Company>Selçuk Güral</Company>
    <Copyright>Copyright © 2026 Selçuk Güral</Copyright>
    <Description>Code fix providers for UnionGenerator analyzers. Provides automatic fixes for union-related diagnostic warnings including pattern matching, status codes, and conversions.</Description>
    <PackageTags>roslyn;analyzer;code-fixes;refactoring;unions</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/selcukgural/UnionGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/selcukgural/UnionGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logo.png</PackageIcon>
    <PackageReleaseNotes>Initial release: Automatic code fixes for union analyzer diagnostics.</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../UnionGenerator.Analyzers/UnionDebugVisualizerCodeFix.cs" Link="UnionDebugVisualizerCodeFix.cs" />
    <Compile Include="../UnionGenerator.Analyzers/CasePatternCodeFixProvider.cs" Link="CasePatternCodeFixProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UnionGenerator.Analyzers/UnionGenerator.Analyzers.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.5.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.5.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.5.0" PrivateAssets="all" />
    <PackageReference Include="System.Composition.AttributedModel" Version="6.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README for NuGet package -->
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Include logo for NuGet package -->
    <None Include="../../logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Package analyzer assembly in the correct NuGet path -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>

