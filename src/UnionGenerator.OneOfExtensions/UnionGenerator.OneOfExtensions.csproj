<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>

    <!-- NuGet Package Metadata -->
    <Version>0.1.0</Version>
    <PackageId>UnionGenerator.OneOfExtensions</PackageId>
    <Authors>Selçuk Güral</Authors>
    <Description>Fluent extension methods for converting OneOf types to UnionGenerator unions. Includes JSON serialization helpers with Newtonsoft.Json support.</Description>
    <PackageTags>oneof;unions;extensions;fluent-api;json;newtonsoft</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/selcukgural/UnionGenerator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/selcukgural/UnionGenerator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OneOf" Version="3.0.271" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnionGenerator\UnionGenerator\UnionGenerator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README for NuGet package -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>

